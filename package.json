{
  "name": "hero-sheets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A kids' D&D-style character builder that prints a 2-page hero sheet.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "demo": "npm run build && node tools/demo.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
